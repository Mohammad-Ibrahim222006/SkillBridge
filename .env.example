# ==============================================================================
# SkillBridge Platform — Unified Environment Variables Example
# ==============================================================================

# Backend Database Credentials (MySQL 8.0+)
DB_URL=jdbc:mysql://localhost:3306/skillbridge_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Backend Security
JWT_SECRET=SkillBridgeSuperSecretSigningKeyForJwtAuthenticationTokens2026!
JWT_EXPIRATION_MS=86400000

# Backend Server Port
PORT=8080

# Backend CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend API Target (Vite)
VITE_API_BASE_URL=http://localhost:8080/api
