# SkillBridge Backend Environment Configuration Template
# Copy this file to .env or export these environment variables before running in production

# Database Connectivity (MySQL)
DB_URL=jdbc:mysql://localhost:3306/skillbridge_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=skillbridge_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Security & JWT Configuration (Minimum 256-bit / 32-character key)
JWT_SECRET=SkillBridgeSuperSecretSigningKeyForJwtAuthenticationTokens2026!
JWT_EXPIRATION_MS=86400000

# Server Port (Defaults to 8080)
PORT=8080

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5174

