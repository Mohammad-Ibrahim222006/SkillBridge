# Root .gitignore for SkillBridge

# Maven / Java
**/target/
**/*.class
**/.settings/
**/.project
**/.classpath
**/.factorypath

# Node / React
**/node_modules/
**/dist/
**/build/
**/.env
**/.env.local
**/.env.*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & OS
.idea/
*.iml
.vscode/
*.swp
*.DS_Store
Thumbs.db

# Logs
logs/
*.log
